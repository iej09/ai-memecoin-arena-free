# ZERO-FEE MODE - NEVER ADD BILLING OR PROVIDER PAID API KEYS.
# AI provider accounts must remain on their FREE TIERS (without billing enabled).
# Separate public GitHub project secrets are preferred over .env for cloud use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_GPT_MODEL=openai/gpt-oss-120b
GROQ_QWEN_MODEL=qwen/qwen3.8-27b
# Jupiter works without a key. Optional free-tier API key:
JUPITER_API_KEY=

# Shared simulated market rules, ZERO REAL TRADES:
INTERVAL_SECONDS=900
DECISION_EVERY=4
MAX_LLM_CALLS_PER_24H=48
MIN_LIQUIDITY_USD=25000
MIN_ORGANIC_SCORE=15
FILL_HAIRCUT=0.005
GAS_USD=0.03
MAX_ROUND_TRIP_LOSS=0.18
EAGER_X=0
# NO OPENAI_API_KEY, ANTHROPIC_API_KEY, X_BEARER_TOKEN, BIRDEYE_API_KEY, HELIUS_API_KEY, or BITQUERY_TOKEN.
